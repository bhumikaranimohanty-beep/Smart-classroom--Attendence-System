require "db.php";

$student_id = intval($_POST["student_id"] ?? 0);
$student_name = trim($_POST["student_name"] ?? "");
$class_name = trim($_POST["class_name"] ?? "");
$status = $_POST["status"] ?? "";

if ($student_id <= 0 || $student_name === "" || $class_name === "" ||
    !in_array($status, ["Present", "Absent"], true)) {
    die("Invalid attendance data.");
}

$stmt = $conn->prepare(
    "INSERT INTO attendance (student_id, student_name, class_name, status, attendance_date)
     VALUES (?, ?, ?, ?, CURDATE())"
);
$stmt->bind_param("isss", $student_id, $student_name, $class_name, $status);

if ($stmt->execute()) {
    echo "<h2>Attendance saved successfully.</h2>";
    echo "<p><a href='../index.html'>Back to Home</a></p>";
} else {
    echo "Error: " . htmlspecialchars($conn->error);
}

$stmt->close();
$conn->close();
?>
